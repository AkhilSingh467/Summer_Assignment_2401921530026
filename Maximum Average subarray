class Solution {
    public double findMaxAverage(int[] nums, int k) {
        int i=0,j=i+k-1,sum=0,maxsum=0;
        for(i=0;i<k;i++){
            sum=sum+nums[i];
        }
        maxsum=sum;
        i=0;
        while(j<nums.length-1){
            sum=sum-nums[i];
            i++;
            j++;
            sum=sum+nums[j];
            if(sum>maxsum)maxsum=sum;
        }
       return((double)maxsum/k);
    }
}
