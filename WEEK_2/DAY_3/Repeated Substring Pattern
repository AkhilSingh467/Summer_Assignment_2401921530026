class Solution {
    public boolean repeatedSubstringPattern(String s) {
        int n = s.length();
        int m = s.length()/2;
        for(int i=1;i<=m;i++){
            if(n%i==0){
                String str = s.substring(0,i);
                int times = n/i;
                StringBuilder sb = new StringBuilder();
                for(int j=0;j<times;j++){
                    sb.append(str);
                }
                if(sb.toString().equals(s))return true;
            }
        }
        return false;
    }
}
