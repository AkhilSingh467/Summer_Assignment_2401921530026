class Solution {
    public int strStr(String haystack, String needle) {
        int n = needle.length();
        int m = needle.charAt(0);
        for(int i=0;i<haystack.length()-n+1;i++){
            if(haystack.charAt(i)==m){
                if(haystack.substring(i,needle.length()+i).equals(needle)){
                    return i;
                }
            }
        }
        return -1;
    }
}
