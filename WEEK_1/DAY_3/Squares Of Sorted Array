class Solution {
    public int[] sortedSquares(int[] nums) {
        int n = nums.length;
        int i=0,j=n-1,idx=n-1;
        int[] ans = new int[n];
        while(i<=j){
            if(Math.abs(nums[i])>Math.abs(nums[j])){
                ans[idx]=nums[i]*nums[i];
                i++;
            }
            else{
                ans[idx]=nums[j]*nums[j];
                j--;
            }
            idx--;
        }
        return ans;
    }
}
