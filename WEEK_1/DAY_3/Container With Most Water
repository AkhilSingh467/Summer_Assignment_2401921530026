class Solution {
    public int maxArea(int[] nums) {
         int n = nums.length;
        int i=0,j=n-1,area=0,maxarea=0;
        while(i<j){
            area = (Math.min(nums[i],nums[j]))*(j-i);
            if(area>maxarea)maxarea=area;
            if(nums[i]<nums[j])i++;
            else j--;
        }
        return maxarea;
    }
}
