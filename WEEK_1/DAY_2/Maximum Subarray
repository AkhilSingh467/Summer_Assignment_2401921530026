class Solution {
    public int maxSubArray(int[] nums) {
        int max = Integer.MIN_VALUE;
        int currentmax = 0;
        for(int i=0;i<nums.length;i++){
            currentmax = nums[i]+currentmax;
            if(currentmax>max){
                max = currentmax;
            }
            if(currentmax<0){
                currentmax=0;
            }
        }
        return max;
    }
}
