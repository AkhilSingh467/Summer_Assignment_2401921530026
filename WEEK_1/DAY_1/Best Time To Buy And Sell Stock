class Solution {
    public int maxProfit(int[] nums) {
        int min = nums[0];
        int maxP = 0;
        for(int i = 1; i < nums.length; i++) {
            if(nums[i] < min) {
                min = nums[i];
            } else {
                maxP= Math.max(maxP, nums[i] - min);
            }
        }
        return maxP;
    }
}
